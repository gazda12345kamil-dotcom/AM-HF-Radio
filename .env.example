# Klucz z https://openrouter.ai/keys — bez niego aplikacja działa w trybie demo
OPENROUTER_API_KEY=

# Model AI do odczytu zdjęć wycen (musi obsługiwać obrazy). Sprawdź nazwę na https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Ile sprawdzeń zdjęć dziennie może zrobić jeden adres IP (ochrona przed nadużyciami)
DAILY_LIMIT_PER_IP=20
